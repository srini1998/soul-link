# Frontend only needs these two. No Daytona / SurrealDB / Arize / Anchor keys belong here —
# those stay server-side in backend/.env.
#
# Vite only injects vars prefixed VITE_ into the client bundle — that's deliberate, it's the
# only way to tell "safe to ship to the browser" apart from "server secret" at a glance.

VITE_ELEVENLABS_API_KEY=
VITE_BACKEND_URL=http://localhost:8000
