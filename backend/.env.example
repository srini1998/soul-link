# Backend-only secrets. Never exposed to the browser. Copy to .env (gitignored).
# Daytona (deploy only, not passed into sandbox)
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# LLM option 1: AWS Bedrock (AWS lab account creds). Used if AWS_ACCESS_KEY_ID is set.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# LLM option 2/3: direct API keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_MODEL=us.anthropic.claude-opus-5-5   (smarter but ~5s/turn; default is sonnet 5.5 at low effort; haiku 5.5 is blocked on the AWS lab account)

# SurrealDB Agent Memory
SURREAL_MEMORY_HOST=
SURREAL_CONTEXT_ID=
SURREAL_API_KEY=sp-...
SURREAL_SCOPES=/soul_link/matchups

# Arize AX
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT=soul-link-grudge-protocol
